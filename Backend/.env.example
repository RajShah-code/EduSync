# Server
PORT=3000

# Local Postgres example:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/EduSync
# Neon example (SSL is auto-detected from "neon.tech" in the URL — no extra config needed):
#   DATABASE_URL=postgresql://<user>:<password>@<your-neon-host>.neon.tech/EduSync?sslmode=require
DATABASE_URL=postgresql://<YOUR_POSTGRES_USER>:<YOUR_POSTGRES_PASSWORD>@localhost:5432/EduSync

# Set to true to force SSL for a non-Neon remote/cloud DB.
# Not needed for local Postgres or for Neon (auto-detected above).
DB_SSL=false

# Auth
JWT_SECRET=any_random_string_here
JWT_EXPIRES_IN=7d
# Shared secret sent by Electron app for Windows Auto-Login; generate a real random value locally, never commit production keys
WINDOWS_LOGIN_CLIENT_KEY=

# Brevo Transactional Email API Key
BREVO_API_KEY=your-brevo-api-key

# Backblaze B2 Object Storage
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
B2_REGION=your-region

# Web Push (EduSync Connect notifications) — OPTIONAL.
# Generate a keypair with: npx web-push generate-vapid-keys
# If any of these three is missing, push notifications silently disable
# themselves (GET /connect/push/vapid-public-key returns 503, sending
# becomes a no-op) instead of crashing the server. On a deployed
# environment (Render, etc.), set these in that platform's own env var
# dashboard — this .env file is never deployed.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

